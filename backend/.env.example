# Copy this file to .env and add your own credentials.
# Never commit backend/.env or paste real API keys into GitHub.

# AI provider: gemini or ollama
AI_PROVIDER=gemini

# Gemini API (leave blank if using Ollama)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama local endpoint (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional: keep AI fallback disabled until the AI extraction layer is implemented.
AI_EXTRACTION_ENABLED=true
