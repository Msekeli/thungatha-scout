APP_NAME=Thungatha Scout API
APP_ENV=development
API_PREFIX=/api/v1

# Dedicated Scout operational database. Never use Thungatha's destination URL.
SCOUT_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres

# Server-to-server vacancy export key. Configure the same secret in Thungatha.
SCOUT_EXPORT_API_KEY=replace-with-a-long-random-secret

# Scout Supabase Auth project settings (not the Thungatha destination project).
SCOUT_SUPABASE_URL=https://YOUR_SCOUT_PROJECT_REF.supabase.co
SCOUT_SUPABASE_PUBLISHABLE_KEY=YOUR_SCOUT_PUBLISHABLE_KEY
SCOUT_ADMIN_EMAIL=admin@example.com

# AI enrichment is opt-in. Deterministic extraction must work without AI credentials.
AI_ENABLED=false
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ENABLED=true
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARACTERS=30000
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Crawlee public careers-page crawler. Browser fallback is used only when justified.
CRAWLER_ENABLED=false
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_MAX_REQUESTS_PER_RUN=100
CRAWLER_MAX_DEPTH=2
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
CRAWLER_MAX_RESPONSE_BYTES=2000000
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_BROWSER_FALLBACK_ENABLED=false
