{
  "_metadata": {
    "purpose": "Implemented ATS adapters and generic public career-page retrieval definitions.",
    "updated_at": "2026-11-13",
    "rule": "Employer-specific board identifiers and evidence belong in employer-source-registry.json."
  },
  "adapters": {
    "greenhouse": {
      "status": "implemented",
      "retrieval": "documented_public_json_api",
      "endpoint": "https://boards-api.greenhouse.io/v1/boards/{slug}/jobs?content=true",
      "config": [
        "slug"
      ],
      "pagination": false,
      "inline_descriptions": true,
      "authentication": false
    },
    "lever": {
      "status": "implemented",
      "retrieval": "documented_public_json_api",
      "endpoint": "https://api.lever.co/v0/postings/{slug}?mode=json",
      "config": [
        "slug",
        "region"
      ],
      "pagination": true,
      "inline_descriptions": true,
      "authentication": false
    },
    "teamtailor": {
      "status": "implemented",
      "retrieval": "public_rss",
      "endpoint": "{careers_url}.rss",
      "config": [
        "careers_url"
      ],
      "pagination": true,
      "inline_descriptions": true,
      "authentication": false
    },
    "workable": {
      "status": "implemented",
      "retrieval": "documented_public_json_api",
      "endpoint": "https://www.workable.com/api/accounts/{slug}?details=true",
      "config": [
        "slug"
      ],
      "pagination": false,
      "inline_descriptions": true,
      "authentication": false
    },
    "workday": {
      "status": "implemented",
      "retrieval": "observed_public_cxs_json",
      "endpoint": "https://{host_prefix}.myworkdayjobs.com/wday/cxs/{tenant}/{site}/jobs",
      "config": [
        "host_prefix",
        "tenant",
        "site"
      ],
      "pagination": true,
      "inline_descriptions": false,
      "authentication": false,
      "constraints": [
        "Undocumented endpoint",
        "Job details require separate requests",
        "Live compatibility must be verified per employer"
      ]
    },
    "career_page": {
      "status": "implemented",
      "retrieval": "crawlee_public_html",
      "endpoint": "Configured official public careers URL",
      "config": [
        "start_url"
      ],
      "pagination": false,
      "inline_descriptions": true,
      "authentication": false,
      "constraints": [
        "Public pages only",
        "Respect robots.txt, terms and access restrictions",
        "Known ATS platforms route to an existing registered employer source",
        "Generic extraction is limited to public JobPosting JSON-LD"
      ]
    }
  }
}
